---

---

<section class="relative overflow-hidden py-24 sm:py-32 lg:py-40">
  <!-- Background gradient effects -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-primary-500/10 blur-[120px]"></div>
    <div class="absolute bottom-0 right-0 h-[300px] w-[500px] rounded-full bg-accent-500/10 blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Badge -->
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-primary-500/20 bg-primary-500/10 px-4 py-1.5 text-sm text-primary-300 light:text-primary-700 light:border-primary-500/30 light:bg-primary-50">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary-500"></span>
        </span>
        Soluciones de IA a medida
      </div>

      <!-- Heading -->
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        <span class="block text-surface-100 light:text-surface-900">Construimos</span>
        <span class="block bg-gradient-to-r from-primary-400 via-primary-300 to-accent-400 bg-clip-text text-transparent">
          Inteligencia Artificial
        </span>
        <span class="block text-surface-100 light:text-surface-900">que transforma negocios</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg leading-relaxed text-surface-400 sm:text-xl light:text-surface-600">
        Somos un equipo especializado en diseño, desarrollo e integración de soluciones
        basadas en IA. Desde chatbots inteligentes hasta pipelines RAG y agentes autónomos.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="#servicios"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary-500 to-primary-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary-500/25 transition-all hover:shadow-primary-500/40 hover:scale-[1.02] active:scale-[0.98]"
        >
          Conoce nuestros servicios
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          href="#equipo"
          class="inline-flex items-center gap-2 rounded-xl border border-surface-700 bg-surface-800/50 px-6 py-3 text-sm font-semibold text-surface-200 transition-all hover:border-surface-600 hover:bg-surface-800 light:border-surface-300 light:bg-white light:text-surface-700 light:hover:border-surface-400 light:hover:bg-surface-50"
        >
          Conoce al equipo
        </a>
      </div>
    </div>

    <!-- Tech indicators -->
    <div class="mx-auto mt-20 max-w-2xl">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm text-surface-500 light:text-surface-400">
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>
          LangChain / LangGraph
        </span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
          RAG & Vector Search
        </span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>
          Agentes Autónomos
        </span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
          FastAPI & Full-Stack
        </span>
      </div>
    </div>
  </div>
</section>

---
import { useTranslations, getLocalePath, type Lang } from "../../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden py-24 sm:py-32 lg:py-40">
  <!-- Background gradient effects -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-primary-500/10 blur-[120px]"></div>
    <div class="absolute bottom-0 right-0 h-[300px] w-[500px] rounded-full bg-accent-500/10 blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Badge -->
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-primary-500/20 bg-th-primary-soft px-4 py-1.5 text-sm text-th-primary">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary-500"></span>
        </span>
        {t("hero.badge")}
      </div>

      <!-- Heading -->
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        <span class="block text-th-text">{t("hero.line1")}</span>
        <span class="block bg-gradient-to-r from-primary-400 via-primary-300 to-accent-400 bg-clip-text text-transparent">
          {t("hero.line2")}
        </span>
        <span class="block text-th-text">{t("hero.line3")}</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-lg leading-relaxed text-th-text-muted sm:text-xl">
        {t("hero.subtitle")}
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="#servicios"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary-500 to-primary-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary-500/25 transition-all hover:shadow-primary-500/40 hover:scale-[1.02] active:scale-[0.98]"
        >
          {t("hero.cta.services")}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          href="#equipo"
          class="inline-flex items-center gap-2 rounded-xl border border-th-border-strong bg-th-bg-subtle px-6 py-3 text-sm font-semibold text-th-text-strong transition-all hover:border-th-border-strong hover:bg-th-hover"
        >
          {t("hero.cta.team")}
        </a>
      </div>
    </div>

    <!-- Tech indicators -->
    <div class="mx-auto mt-20 max-w-2xl">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm text-th-text-faint">
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>
          LangChain / LangGraph
        </span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
          RAG & Vector Search
        </span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>
          {t("hero.tech.agents")}
        </span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
          FastAPI & Full-Stack
        </span>
      </div>
    </div>
  </div>
</section>

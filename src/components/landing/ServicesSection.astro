---
const services = [
  {
    title: "Chatbots Inteligentes",
    description: "Asistentes conversacionales con IA generativa, integrados en web, WhatsApp o plataformas empresariales.",
    icon: "chat",
  },
  {
    title: "Sistemas RAG",
    description: "Búsqueda semántica y generación aumentada por recuperación sobre tus propios datos y documentos.",
    icon: "search",
  },
  {
    title: "Agentes Autónomos",
    description: "Agentes multi-paso con LangGraph que razonan, planifican y ejecutan tareas complejas.",
    icon: "agent",
  },
  {
    title: "Pipelines de Datos",
    description: "ETL inteligente, procesamiento de documentos y flujos de datos con integración de modelos ML/IA.",
    icon: "data",
  },
  {
    title: "Integración de APIs IA",
    description: "Conexión con OpenAI, Anthropic, Google y modelos open-source para tus aplicaciones.",
    icon: "api",
  },
  {
    title: "Consultoría IA",
    description: "Evaluación, diseño de arquitectura y estrategia de adopción de IA para tu empresa.",
    icon: "strategy",
  },
];

const iconPaths: Record<string, string> = {
  chat: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  search: "M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z",
  agent: "M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714a2.25 2.25 0 00.659 1.591L19 14.5M14.25 3.104c.251.023.501.05.75.082M19 14.5l-2.47 2.47a2.25 2.25 0 01-1.591.659H9.061a2.25 2.25 0 01-1.591-.659L5 14.5m14 0V5a2 2 0 00-2-2H7a2 2 0 00-2 2v9.5",
  data: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
  api: "M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z",
  strategy: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
};
---

<section id="servicios" class="py-24 sm:py-32 bg-th-bg-section">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-widest text-th-accent">
        Servicios
      </span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-th-text sm:text-4xl">
        Lo que podemos hacer por ti
      </h2>
      <p class="mt-4 text-lg text-th-text-muted">
        Soluciones end-to-end en inteligencia artificial, desde la idea hasta producción.
      </p>
    </div>

    <!-- Services grid -->
    <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <div class="group rounded-2xl border border-th-border bg-th-bg-card p-6 transition-all duration-300 hover:border-accent-500/30 hover:bg-th-bg-subtle hover:shadow-md">
          <!-- Icon -->
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-th-accent-soft text-th-accent transition-colors group-hover:bg-accent-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[service.icon]} />
            </svg>
          </div>

          <h3 class="text-lg font-semibold text-th-text">
            {service.title}
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-th-text-muted">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

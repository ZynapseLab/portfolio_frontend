---
const team = [
  {
    name: "Jonathan",
    slug: "jonathan",
    role: "AI Engineer",
    summary: "Especialista en agentes inteligentes, LangGraph y arquitecturas RAG.",
  },
  {
    name: "Pablo",
    slug: "pablo",
    role: "AI Full-Stack Developer",
    summary: "Desarrollo full-stack con foco en integración de modelos de IA y pipelines de datos.",
  },
];
---

<section id="equipo" class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-widest text-primary-400 light:text-primary-600">
        Nuestro equipo
      </span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-surface-100 sm:text-4xl light:text-surface-900">
        Conoce a los expertos
      </h2>
      <p class="mt-4 text-lg text-surface-400 light:text-surface-600">
        Un equipo comprometido con la excelencia en inteligencia artificial
        y desarrollo de software.
      </p>
    </div>

    <!-- Team grid -->
    <div class="mx-auto mt-16 grid max-w-4xl grid-cols-1 gap-8 sm:grid-cols-2">
      {team.map((member) => (
        <a
          href={`/${member.slug}`}
          class="group relative rounded-2xl border border-surface-800/60 bg-surface-900/50 p-8 transition-all duration-300 hover:border-primary-500/30 hover:bg-surface-800/50 hover:shadow-lg hover:shadow-primary-500/5 light:border-surface-200 light:bg-white light:hover:border-primary-400/40 light:hover:shadow-primary-500/10"
        >
          <!-- Avatar placeholder -->
          <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500/20 to-accent-500/20 text-2xl font-bold text-primary-400 light:from-primary-100 light:to-accent-100 light:text-primary-600">
            {member.name[0]}
          </div>

          <h3 class="text-xl font-semibold text-surface-100 group-hover:text-primary-400 transition-colors light:text-surface-900 light:group-hover:text-primary-600">
            {member.name}
          </h3>

          <p class="mt-1 text-sm font-medium text-primary-400/80 light:text-primary-600">
            {member.role}
          </p>

          <p class="mt-3 text-sm leading-relaxed text-surface-400 light:text-surface-600">
            {member.summary}
          </p>

          <!-- Arrow indicator -->
          <div class="mt-6 flex items-center gap-2 text-sm font-medium text-surface-500 group-hover:text-primary-400 transition-colors light:group-hover:text-primary-600">
            Ver portfolio
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

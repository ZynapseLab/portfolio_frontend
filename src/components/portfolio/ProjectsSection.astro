---
import { useTranslations, type Lang } from "../../i18n/utils";

interface Project {
  title: string;
  description: string;
  imageUrl?: string;
  tags?: string[];
  demoUrl?: string;
  repoUrl?: string;
}

interface Props {
  projects?: Project[];
  lang?: Lang;
}

const { projects = [], lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<section>
  <h2 class="text-2xl font-bold text-th-text">
    {t("portfolio.projects")}
  </h2>
  <div class="mt-1 h-1 w-12 rounded-full bg-gradient-to-r from-primary-500 to-accent-500"></div>

  <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {(projects.length > 0 ? projects : [
      { title: "", description: "", tags: [] },
      { title: "", description: "", tags: [] },
      { title: "", description: "", tags: [] },
      { title: "", description: "", tags: [] },
    ]).map((project) => (
      <div class="group overflow-hidden rounded-xl border border-th-border bg-th-bg-card transition-all hover:border-primary-500/30 hover:shadow-lg hover:shadow-primary-500/5">
        {/* Image area */}
        <div class="aspect-video w-full bg-th-bg-subtle">
          {project.imageUrl ? (
            <img
              src={project.imageUrl}
              alt={project.title}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            />
          ) : (
            <div class="flex h-full items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-th-text-faint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={1}>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
              </svg>
            </div>
          )}
        </div>

        {/* Content */}
        <div class="p-5">
          {project.title ? (
            <>
              <h3 class="text-lg font-semibold text-th-text group-hover:text-th-primary transition-colors">
                {project.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-th-text-muted">
                {project.description}
              </p>
              {project.tags && project.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="rounded-full bg-th-primary-soft px-2 py-0.5 text-xs font-medium text-th-primary">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              {/* Links */}
              <div class="mt-4 flex gap-3">
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-th-primary hover:text-th-primary-hover transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                    Demo
                  </a>
                )}
                {project.repoUrl && (
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-th-text-muted hover:text-th-text-strong transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                    </svg>
                    {t("portfolio.projects.code")}
                  </a>
                )}
              </div>
            </>
          ) : (
            <>
              <div class="h-5 w-40 rounded bg-th-skeleton"></div>
              <div class="mt-2 h-3 w-full rounded bg-th-skeleton/50"></div>
              <div class="mt-1.5 h-3 w-2/3 rounded bg-th-skeleton/50"></div>
              <div class="mt-3 flex gap-1.5">
                <div class="h-5 w-14 rounded-full bg-th-skeleton/60"></div>
                <div class="h-5 w-14 rounded-full bg-th-skeleton/60"></div>
              </div>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

---
import { useTranslations, type Lang } from "../../i18n/utils";

interface Experience {
  company: string;
  role: string;
  period: string;
  description?: string;
  tags?: string[];
}

interface Props {
  experiences?: Experience[];
  lang?: Lang;
}

const { experiences = [], lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<section>
  <h2 class="text-2xl font-bold text-th-text">
    {t("portfolio.experience")}
  </h2>
  <div class="mt-1 h-1 w-12 rounded-full bg-gradient-to-r from-primary-500 to-accent-500"></div>

  <div class="mt-8 relative">
    <!-- Timeline line -->
    <div class="absolute left-[11px] top-2 bottom-2 w-px bg-th-skeleton"></div>

    <div class="space-y-8">
      {(experiences.length > 0 ? experiences : [
        { company: "", role: "", period: "", description: "", tags: [] },
        { company: "", role: "", period: "", description: "", tags: [] },
        { company: "", role: "", period: "", description: "", tags: [] },
      ]).map((exp) => (
        <div class="relative pl-10">
          {/* Timeline dot */}
          <div class="absolute left-0 top-1.5 h-6 w-6 rounded-full border-2 border-th-border-strong bg-th-bg flex items-center justify-center">
            <div class="h-2 w-2 rounded-full bg-primary-500"></div>
          </div>

          <div class="rounded-xl border border-th-border bg-th-bg-card p-5 transition-all hover:border-th-border-strong">
            {exp.company ? (
              <>
                <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                  <h3 class="text-base font-semibold text-th-text">
                    {exp.role}
                  </h3>
                  <span class="text-xs font-medium text-th-text-faint">
                    {exp.period}
                  </span>
                </div>
                <p class="mt-1 text-sm font-medium text-th-primary">
                  {exp.company}
                </p>
                {exp.description && (
                  <p class="mt-3 text-sm leading-relaxed text-th-text-muted">
                    {exp.description}
                  </p>
                )}
                {exp.tags && exp.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {exp.tags.map((tag) => (
                      <span class="rounded-full bg-th-bg-subtle px-2 py-0.5 text-xs text-th-text-muted">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </>
            ) : (
              <>
                <div class="h-5 w-48 rounded bg-th-skeleton"></div>
                <div class="mt-2 h-4 w-32 rounded bg-th-skeleton/60"></div>
                <div class="mt-3 h-3 w-full rounded bg-th-skeleton/40"></div>
                <div class="mt-1.5 h-3 w-3/4 rounded bg-th-skeleton/40"></div>
              </>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

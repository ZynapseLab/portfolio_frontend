---
interface TechItem {
  name: string;
  iconUrl?: string;
}

interface StackCategory {
  category: string;
  items: TechItem[];
}

interface Props {
  stack?: StackCategory[];
}

const { stack = [] } = Astro.props;
---

<section>
  <h2 class="text-2xl font-bold text-surface-100 light:text-surface-900">
    Stack Tecnológico
  </h2>
  <div class="mt-1 h-1 w-12 rounded-full bg-gradient-to-r from-primary-500 to-accent-500"></div>

  <div class="mt-8 space-y-8">
    {(stack.length > 0 ? stack : [
      { category: "Lenguajes", items: Array.from({ length: 4 }, () => ({ name: "" })) },
      { category: "Frameworks", items: Array.from({ length: 4 }, () => ({ name: "" })) },
      { category: "Herramientas", items: Array.from({ length: 4 }, () => ({ name: "" })) },
    ]).map((group) => (
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-widest text-surface-500 light:text-surface-400">
          {group.category}
        </h3>
        <div class="flex flex-wrap gap-3">
          {group.items.map((item) => (
            <div class="flex items-center gap-2.5 rounded-xl border border-surface-800/60 bg-surface-900/40 px-4 py-2.5 transition-all hover:border-surface-700 light:border-surface-200 light:bg-white light:hover:border-surface-300">
              {item.iconUrl ? (
                <img src={item.iconUrl} alt={item.name} class="h-5 w-5" />
              ) : (
                <div class="flex h-5 w-5 items-center justify-center rounded bg-accent-500/10 text-[10px] font-bold text-accent-400 light:bg-accent-50 light:text-accent-600">
                  {item.name ? item.name[0] : "?"}
                </div>
              )}
              {item.name ? (
                <span class="text-sm font-medium text-surface-200 light:text-surface-700">
                  {item.name}
                </span>
              ) : (
                <div class="h-4 w-16 rounded bg-surface-800 light:bg-surface-200"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

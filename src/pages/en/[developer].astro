---
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import HeroSection from "../../components/portfolio/HeroSection.astro";
import SkillsSection from "../../components/portfolio/SkillsSection.astro";
import ExperienceSection from "../../components/portfolio/ExperienceSection.astro";
import ProjectsSection from "../../components/portfolio/ProjectsSection.astro";
import StackSection from "../../components/portfolio/StackSection.astro";
import ChatWidget from "../../components/chat/ChatWidget";
import { getDeveloperData } from "../../data";

export function getStaticPaths() {
  return [
    { params: { developer: "jonathan" } },
    { params: { developer: "pablo" } },
  ];
}

const { developer } = Astro.params;
const data = getDeveloperData(developer, "en");
const displayName = data?.hero.name ?? developer.charAt(0).toUpperCase() + developer.slice(1);
---

<PortfolioLayout developer={developer} title={`${displayName} — Portfolio`} lang="en">
  <HeroSection
    name={data?.hero.name}
    role={data?.hero.role}
    bio={data?.hero.bio}
    avatarUrl={data?.hero.avatarUrl}
    links={data?.hero.links}
    lang="en"
  />
  <SkillsSection skills={data?.skills} />
  <ExperienceSection experiences={data?.experiences} lang="en" />
  <ProjectsSection projects={data?.projects} lang="en" />
  <StackSection stack={data?.stack} lang="en" />
  <ChatWidget client:idle scope={developer} lang="en" />
</PortfolioLayout>

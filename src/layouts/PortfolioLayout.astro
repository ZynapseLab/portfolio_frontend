---
import MainLayout from "./MainLayout.astro";
import { useTranslations, getLocalePath, type Lang } from "../i18n/utils";

interface Props {
  developer: string;
  title: string;
  lang?: Lang;
}

const { developer, title, lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<MainLayout title={title} lang={lang}>
  <Fragment slot="nav-actions">
    <a
      href={getLocalePath("/", lang)}
      class="text-sm text-th-text-muted hover:text-th-primary transition-colors"
    >
      &larr; {t("nav.backToHome")}
    </a>
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 space-y-20">
    <slot />
  </div>
</MainLayout>

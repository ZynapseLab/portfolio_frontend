---
import MainLayout from "./MainLayout.astro";

interface Props {
  developer: string;
  title: string;
}

const { developer, title } = Astro.props;
---

<MainLayout title={title}>
  <Fragment slot="nav-actions">
    <a
      href="/"
      class="text-sm text-th-text-muted hover:text-th-primary transition-colors"
    >
      &larr; Volver al inicio
    </a>
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 space-y-20">
    <slot />
  </div>
</MainLayout>
